Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^build/\.vite(?:/|$) - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(?:css|js|glb|gltf|bin|webp|avif|png|jpe?g|svg|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <Files "index.php">
        Header set Cache-Control "no-store"
    </Files>
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
