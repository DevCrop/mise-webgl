{
  "name": "mise-ui",
  "version": "0.2.0-rc.1",
  "description": "Component contracts, DOM controllers, and Sass foundations for MISE web interfaces.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "sideEffects": [
    "./dist/*.css"
  ],
  "files": [
    "dist",
    "contracts",
    "docs",
    "styles",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/Index.d.ts",
      "import": "./dist/Index.js"
    },
    "./styles.css": "./dist/MiseUi.css",
    "./styles.scss": {
      "sass": "./styles/Index.scss",
      "default": "./styles/Index.scss"
    },
    "./tokens.scss": {
      "sass": "./styles/abstract/_tokens.scss",
      "default": "./styles/abstract/_tokens.scss"
    },
    "./component-contract.schema.json": "./contracts/ComponentContract.schema.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "build": "tsc -p tsconfig.build.json && npm run build:styles",
    "build:styles": "sass --style=compressed --source-map styles/Index.scss dist/MiseUi.css",
    "test": "vitest run --config vitest.config.ts",
    "verify": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run verify"
  },
  "devDependencies": {
    "sass": "^1.101.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.19.0 <21",
    "npm": ">=10.8.0"
  }
}
